# SenyAlert local environment configuration
# Copy this file to senyalert.env and fill in only the values used by this installation.
# Process-level environment values override entries here. Do not commit senyalert.env.

# Existing data directory. Leave blank to use SenyAlert's normal local data location.
SENYALERT_DATA_DIR=

# Source-project location and Python executable. Leave blank for automatic discovery / `python`.
SENYALERT_PROJECT_ROOT=
SENYALERT_PYTHON=

# The dashboard launches its owned local engine only after a normal login succeeds.
SENYALERT_ENGINE_AUTOSTART=true
SENYALERT_WS_URL=ws://localhost:8080

# Required before Remote Support can start on a new client installation.
# Use a unique 8-128 character installation ID; do not use a password here.
SENYALERT_CLIENT_ID=
SENYALERT_CLIENT_NAME=

# Client Remote Support settings. Keep the support secret private and at least 32 characters.
SENYALERT_SUPPORT_SECRET=
SENYALERT_CLOUDFLARED=cloudflared

# Developer computer only. Generate a PBKDF2 verifier with SuperadminPasswordTool.
SENYALERT_SUPERADMIN_PASSWORD_HASH=

# Optional camera source variables referenced by a camera setting such as env:CAMERA_ENTRY_SOURCE.
CAMERA_ENTRY_SOURCE=
